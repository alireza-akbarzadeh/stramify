{"nodes": [{"id": "claude_skills_graphify_references_extraction_spec_extractionsubagentprompt", "label": "Graphify extraction subagent prompt", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_confidencerubric", "label": "Discrete confidence-score rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models follow discrete rubrics better than continuous ranges; the bimodal distribution observed in production (>50% at 0.5, >40% at 0.85+) shows range guidance collapses to a binary, hence fixed rubric values (0.95/0.85/0.75/0.65/0.55) instead of a free 0-1 scale."}, {"id": "claude_skills_graphify_references_extraction_spec_nodeidformat", "label": "Node ID format ({stem}_{entity})", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must match the ID the AST extractor generates (full repo-relative path, every directory level kept) so semantic and AST extraction agree on the same node instead of creating orphan ghost-duplicate nodes."}, {"id": "claude_skills_graphify_references_extraction_spec_hyperedgerule", "label": "Hyperedge extraction rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_semanticsimilarityrule", "label": "Semantic similarity edge rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/e