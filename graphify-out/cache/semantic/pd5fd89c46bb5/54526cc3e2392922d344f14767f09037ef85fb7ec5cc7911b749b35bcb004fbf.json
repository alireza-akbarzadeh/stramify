{"nodes": [{"id": "claude_skills_graphify_references_query_queryflow", "label": "/graphify query BFS/DFS traversal flow", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_vocabexpansion", "label": "Constrained query vocabulary expansion (Step 0)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's query CLI matches via case-folded substring + IDF with no stemming/synonyms/cross-language match, so a literal user query in different vocabulary than the graph's labels returns zero hits and the answer collapses to noise; expanding against the actual graph vocabulary first (never inventing tokens) fixes this."}, {"id": "claude_skills_graphify_references_query_pathflow", "label": "/graphify path shortest-path flow", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_explainflow", "label": "/graphify explain node flow", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_saveresult", "label": "graphify save-result CLI", "file_type": "code", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_reflect", "label": "graphify reflect / LESSONS.md work memory", "file_type": "code", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "save-result with --outcome useful|dead_end|corrected closes a self-improving feedback loop: reflect reads it back into preferred sources, known dead ends, and prior corrections for the next session."}], "edges": [{"source": "claude_skills_graphify_references_query_queryflow", "target": "claude_skills_graphify_references_query_vocabexpansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_queryflow", "target": "claude_skills_graphify_references_query_saveresult", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_pathflow", "target": "claude_skills_graphify_references_query_saveresult", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_explainflow", "target": "claude_skills_graphify_references_query_saveresult", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_saveresult", "target": "claude_skills_graphify_references_query_reflect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_query_queryflow", "target": "claude_skill