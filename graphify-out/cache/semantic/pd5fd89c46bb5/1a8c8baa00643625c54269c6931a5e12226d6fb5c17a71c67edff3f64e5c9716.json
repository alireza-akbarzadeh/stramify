{"nodes": [{"id": "claude_skills_motion_skill_tracka", "label": "Track A - Reka UI overlays (data-state + tw-animate-css)", "file_type": "concept", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reka's Presence (usePresence) watches for a real CSS animationend/animationcancel event before removing a closing element from the DOM; giving the closing state a data-[state=closed]:animate-out class makes Reka automatically delay unmount until the animation finishes. This only works with `animation`, not `transition` - a plain transition-* class never fires animationend."}, {"id": "claude_skills_motion_skill_trackb", "label": "Track B - motion-v content animation", "file_type": "concept", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_usepresence", "label": "reka-ui usePresence", "file_type": "code", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_timingtable", "label": "Motion timing table (durations/easings)", "file_type": "concept", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An established rhythm (duration-200 overlays, 700ms cubic-bezier(0.16,1,0.3,1) scroll reveals) should be reused rather than picking arbitrary numbers per component - inconsistent motion reads as sloppier than no motion at all."}, {"id": "claude_skills_motion_skill_accessibilityrule", "label": "Reduced-motion accessibility rule", "file_type": "concept", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_reveal", "label": "app/components/motion/Reveal.vue", "file_type": "code", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_magnetic", "label": "app/components/motion/Magnetic.vue", "file_type": "code", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_countup", "label": "app/components/motion/CountUp.vue", "file_type": "code", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_marquee", "label": "app/components/motion/Marquee.vue", "file_type": "code", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_motion_skill_commonpitfalls", "label": "Motion common pitfalls list", "file_type": "concept", "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_motion_skill_tracka", "target": "claude_skills_motion_skill_usepresence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_motion_skill_tracka", "target": "claude_skills_motion_skill_trackb", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/motion/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_motion_skill_trackb", "target": "claude_skills_motion_skill_reveal", "rel