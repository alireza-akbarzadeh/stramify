# Copy to .env and fill in. Never commit .env — see .gitignore.

NODE_ENV=development

# --- App -----------------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 3 — required for auth to function) ------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/streamify

# --- Auth (Phase 3 — better-auth, ADR-007) --------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional OAuth providers. A provider is only offered on the sign-in page
# when BOTH of its variables are set — leave blank to hide that button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Redis (Phase 7/8 — realtime chat & viewer counts, ADR-006) ----------
REDIS_URL=redis://localhost:6379

# --- Cloudflare Stream (Phase 7 — video, ADR-005) -------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Cloudflare R2 (Phase 6/9 — object storage, avatars/thumbnails) -------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# --- Observability (Phase 12 — error tracking) ----------------------------
SENTRY_DSN=
