{
  "permissions": {
    "allow": [
      "Bash(curl -s https://api.github.com/repos/nextlevelbuilder/ui-ux-pro-max-skill)",
      "Bash(npm -v)",
      "Bash(npm view *)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:3210/)",
      "Bash(curl -s http://localhost:3210/)",
      "Bash(command -v uv)",
      "Bash(uv --version)",
      "Bash(command -v python3)",
      "Bash(command -v python)",
      "Bash(uv tool *)",
      "Bash(graphify --version)",
      "Bash(graphify install *)",
      "Bash(uv run *)",
      "Bash(node -e ' *)",
      "Bash(npx nuxt *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/akbarzadeh.ali/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/akbarzadeh.ali/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}
